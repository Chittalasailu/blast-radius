# Copy to .env and fill in from the CognoDB Cloud console.
# The password for user "cognodb" is displayed exactly once at instance creation.
# .env is gitignored and must never be committed.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<generated-password>

# Optional. Defaults to 4173. The server always binds 127.0.0.1.
PORT=4173
