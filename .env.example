# Copy to .env and fill in from the CognoDB Cloud console.
# The password for user "cognodb" is generated at instance creation and can be
# re-read at any time from the instance's Connect panel in the console.
# .env is gitignored and must never be committed.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=<generated-password>

# Optional. Defaults to 4173. The server always binds 127.0.0.1.
PORT=4173
